{
  "name": "malenjo-suite",
  "private": true,
  "version": "0.1.0",
  "description": "MALENJO Suite — local-first student document workspace",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run verify:offline-runtime && tauri build",
    "tauri:release": "npm run pdf:release-check && npm run tauri:build",
    "pdf:release-status": "node scripts/pdf-release-readiness.mjs",
    "pdf:release-check": "node scripts/pdf-release-readiness.mjs --strict",
    "test:pdf-release-gate": "node --test scripts/pdf-release-readiness.check.mjs",
    "verify:offline-runtime": "node scripts/verify-offline-runtime.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "verify:codespace": "bash scripts/verify-codespace.sh",
    "dev:codespace": "vite --host 0.0.0.0",
    "ai:codespace:check": "bash scripts/check-codespace-ai.sh",
    "ai:codespace:setup": "bash scripts/setup-codespace-ai.sh runtime",
    "ai:codespace:setup:model": "bash scripts/setup-codespace-ai.sh model",
    "ai:models:validate": "python3 scripts/validate-ai-model-manifest.py"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "pdfjs-dist": "6.4.299",
    "fflate": "0.8.3",
    "tesseract.js": "7.0.0",
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0"
  }
}
